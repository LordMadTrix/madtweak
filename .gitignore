# Réglages locaux de Claude Code : chemins personnels, rien à publier.
.claude/settings.local.json
# Verrou de tâche planifiée : fichier d'exécution local, sans intérêt versionné.
.claude/scheduled_tasks.lock

# Sorties générées par l'outil (il les recrée à la demande).
signatures/
signatures-themes/
*.png
theme.txt

# ...sauf les visuels du dépôt (logo du README), eux versionnés.
!assets/*.png
!docs/assets/*.png

# Données de session (elles vivent normalement dans %LOCALAPPDATA%\MadTweak,
# mais un repli les écrit à côté du script si ce dossier manque).
madtweak-donnees/
madtweak-log-*.txt
sauvegarde-*.json
cles-appliquees.json
profils-perso.json
mes-apps.json
rapport-madtweak-*.html
